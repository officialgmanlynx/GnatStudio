
project Main is

   

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O0");
      for Switches ("Ada") use ("-gnat2022", "-gnatX", "-gnata");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
      for Global_Configuration_Pragmas use "main.adc";
   end Builder;

end Main;
