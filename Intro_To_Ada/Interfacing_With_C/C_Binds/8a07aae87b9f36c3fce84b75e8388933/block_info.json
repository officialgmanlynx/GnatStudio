    "text": "with Interfaces.C; use Interfaces.C;\nwith Ada.Text_IO;  use Ada.Text_IO;\nwith test_h;       use test_h;\n\nprocedure Show_C_Func is\n   V : int;\nbegin\n   V := my_func (1);\n   V := my_func (2);\n   V := my_func (3);\n\n   Put_Line (\"Result is \"\n             & int'Image (V));\n\n   Put_Line (\"Function was called \"\n             & int'Image (func_cnt)\n             & \" times\");\nend Show_C_Func;\n",
