    "text": "with Dates; use Dates;\n\npackage Access_Types is\n   type Date_Acc is access Date;\n\n   D     : Date_Acc :=\n             new Date'(30, November, 2011);\n\n   Today : Date := D.all;\n   --              ^ Access value dereference\n   J     : Integer := D.Day;\n   --                 ^ Implicit dereference\n   --                   for record and array\n   --                   components\n   --                   Equivalent to D.all.day\nend Access_Types;\n",
