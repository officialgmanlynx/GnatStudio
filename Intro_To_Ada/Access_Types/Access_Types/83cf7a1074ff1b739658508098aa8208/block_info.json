    "text": "with Dates; use Dates;\n\npackage Access_Types is\n   type String_Acc is access String;\n   --                        ^\n   --  Access to unconstrained array type\n   Msg : String_Acc;\n   --    ^ Default value is null\n\n   Buffer : String_Acc :=\n     new String (1 .. 10);\n   --            ^ Constraint required\nend Access_Types;\n",
