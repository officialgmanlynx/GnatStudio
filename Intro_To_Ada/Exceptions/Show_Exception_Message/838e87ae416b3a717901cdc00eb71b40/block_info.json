    "text": "with Ada.Text_IO; use Ada.Text_IO;\nwith Ada.Exceptions;  use Ada.Exceptions;\n\nprocedure Open_File is\n   File : File_Type;\nbegin\n   Open (File, In_File, \"input.txt\");\n--  Exception block can be added to any block\nexception\n   when Name_Error =>\n      Put (\"Cannot open input file\");\nend Open_File;\n",
