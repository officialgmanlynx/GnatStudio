    "text": "with Ada.Text_IO;         use Ada.Text_IO;\nwith Ada.Integer_Text_IO; use Ada.Integer_Text_IO;\n\nprocedure Check_Positive is\n   N : Integer;\nbegin\n   --  Put a String\n   Put (\"Enter an integer value: \");\n\n   --  Read in an integer value\n   Get (N);\n\n   if N > 0 then\n      --  Put an Integer\n      Put (N);\n      Put_Line (\" is a positive number\");\n   end if;\nend Check_Positive;\n",
