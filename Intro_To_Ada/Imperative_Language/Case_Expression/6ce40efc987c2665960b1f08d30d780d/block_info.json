    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\nbegin\n   for I in 1 .. 10 loop\n      Put_Line\n        (case I is\n         when 1 | 3 | 5 | 7 | 9  => \"Odd\",\n         when 2 | 4 | 6 | 8 | 10 => \"Even\");\n   end loop;\nend Main;\n",
