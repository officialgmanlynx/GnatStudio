    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Greet_5c is\n   I : Integer := 1;\nbegin\n   --  Condition must be a Boolean value\n   --  (no Integers).\n   --  Operator \"<=\" returns a Boolean\n   while I <= 5 loop\n      Put_Line (\"Hello, World!\"\n                & Integer'Image (I));\n\n      I := I + 1;\n   end loop;\nend Greet_5c;\n",
