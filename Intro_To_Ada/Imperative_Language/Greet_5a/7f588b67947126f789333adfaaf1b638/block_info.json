    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Greet_5a is\nbegin\n   for I in 1 .. 5 loop\n      --  Put_Line is a procedure call\n      Put_Line (\"Hello, World!\"\n                  & Integer'Image (I));\n      --        ^ Procedure parameter\n   end loop;\nend Greet_5a;\n",
