    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Greet is\nbegin\n   loop\n      Put_Line (\"Please enter your name: \");\n\n      declare\n         Name : String := Get_Line;\n         --               ^ Call to the\n         --                 Get_Line function\n      begin\n         exit when Name = \"\";\n         Put_Line (\"Hi \" & Name & \"!\");\n      end;\n\n      --  Name is undefined here\n   end loop;\n\n  Put_Line (\"Bye!\");\nend Greet;\n",
