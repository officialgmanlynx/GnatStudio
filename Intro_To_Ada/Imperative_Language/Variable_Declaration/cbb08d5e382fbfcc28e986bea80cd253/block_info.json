    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   X : Integer;\nbegin\n   X := 0;\n   Put_Line (\"The initial value of X is \"\n             & Integer'Image (X));\n\n   Put_Line (\"Performing operation on X...\");\n   X := X + 1;\n\n   Put_Line (\"The value of X now is \"\n             & Integer'Image (X));\nend Main;\n",
