    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Greet_5b is\n   --  Variable declaration:\n   I : Integer := 1;\n   --  ^ Type\n   --             ^ Initial value\nbegin\n   loop\n      Put_Line (\"Hello, World!\"\n                & Integer'Image (I));\n\n      --  Exit statement:\n      exit when I = 5;\n      --        ^ Boolean condition\n\n      --  Assignment:\n      I := I + 1;\n      --  There is no I++ short form to\n      --  increment a variable\n   end loop;\nend Greet_5b;\n",
