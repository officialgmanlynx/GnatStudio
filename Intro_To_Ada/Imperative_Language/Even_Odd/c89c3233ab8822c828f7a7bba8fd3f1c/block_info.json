    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\nbegin\n   for I in 1 .. 10 loop\n      Put_Line (if I mod 2 = 0\n                  then \"Even\"\n                  else \"Odd\");\n   end loop;\nend Main;\n",
