    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Simple_Sync is\n   task T;\n   task body T is\n   begin\n      for I in 1 .. 10 loop\n         Put_Line (\"hello\");\n      end loop;\n   end T;\nbegin\n   null;\n   --  Will wait here until all tasks\n   --  have terminated\nend Show_Simple_Sync;\n",
