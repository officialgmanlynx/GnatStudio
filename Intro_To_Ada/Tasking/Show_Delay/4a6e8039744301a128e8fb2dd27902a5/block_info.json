    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Delay is\n\n   task T;\n\n   task body T is\n   begin\n      for I in 1 .. 5 loop\n         Put_Line (\"hello from task T\");\n         delay 1.0;\n         --    ^ Wait 1.0 seconds\n      end loop;\n   end T;\nbegin\n   delay 1.5;\n   Put_Line (\"hello from main\");\nend Show_Delay;\n",
