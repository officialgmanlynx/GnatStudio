    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type Mod_Int is mod 2 ** 5;\n   --              ^ Range is 0 .. 31\n\n   A : constant Mod_Int := 20;\n   B : constant Mod_Int := 15;\n\n   M : constant Mod_Int := A + B;\n   --  No overflow here,\n   --  M = (20 + 15) mod 32 = 3\nbegin\n   for I in 1 .. M loop\n      Put_Line (\"Hello, World!\");\n   end loop;\nend Main;\n",
