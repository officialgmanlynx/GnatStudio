    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Floating_Point_Range_Exception is\n   type T_Norm  is new Float range -1.0 .. 1.0;\n   A  : T_Norm;\nbegin\n   A := 2.0;\n   Put_Line (\"The value of A is \"\n             & T_Norm'Image (A));\nend Floating_Point_Range_Exception;\n",
