    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Floating_Point_Operations is\n   A : Float := 2.5;\nbegin\n   A := abs (A - 4.5);\n   Put_Line (\"The value of A is \"\n             & Float'Image (A));\n\n   A := A ** 2 + 1.0;\n   Put_Line (\"The value of A is \"\n             & Float'Image (A));\nend Floating_Point_Operations;\n",
