    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type My_Int is range 1 .. 20;\n   A : My_Int := 12;\n   B : My_Int := 15;\n   M : My_Int := (A + B) / 2;\n   --  No overflow here, overflow checks\n   --  are done at specific boundaries.\nbegin\n   for I in 1 .. M loop\n      Put_Line (\"Hello, World!\");\n   end loop;\n   --  Loop body executed 13 times\nend Main;\n",
