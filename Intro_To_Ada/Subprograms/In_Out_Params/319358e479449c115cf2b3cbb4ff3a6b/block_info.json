    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure In_Out_Params is\n   procedure Swap (A, B : in out Integer) is\n      Tmp : Integer;\n   begin\n      Tmp := A;\n      A   := B;\n      B   := Tmp;\n   end Swap;\n\n   A : Integer := 12;\n   B : Integer := 44;\nbegin\n    Swap (A, B);\n\n    --  Prints 44\n    Put_Line (Integer'Image (A));\nend In_Out_Params;\n",
