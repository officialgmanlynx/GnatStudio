    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n    Buf : String := \"Hello ...\";\n\n    Full_Name : String := \"John Smith\";\nbegin\n    Buf (7 .. 9) := \"Bob\";\n    --  Careful! This works because the string\n    --  on the right side is the same length as\n    --  the replaced slice!\n\n    --  Prints \"Hello Bob\"\n    Put_Line (Buf);\n\n     --  Prints \"Hi John\"\n    Put_Line (\"Hi \" & Full_Name (1 .. 4));\nend Main;\n",
