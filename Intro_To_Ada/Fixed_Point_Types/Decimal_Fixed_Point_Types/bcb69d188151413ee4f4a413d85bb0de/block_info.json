    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Decimal_Fixed_Point_Types is\n   type Decimal is\n     delta 10.0 ** (-1) digits 3;\n\n   --  Alternatively:\n   --  type Decimal is\n   --    delta 0.1 digits 3;\nbegin\n   Put_Line\n     (\"The decimal precision of Decimal is \"\n      & Decimal'Delta'Image);\nend Decimal_Fixed_Point_Types;\n",
