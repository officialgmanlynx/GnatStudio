    "text": "with P; use P;\n\nprocedure Main is\n   package Extend is\n      type D2 is new Derived with null record;\n\n      procedure Bar (Self : in out D2;\n                     Val  :        Integer);\n   end Extend;\n\n   package body Extend is\n      procedure Bar (Self : in out D2;\n                     Val  :        Integer) is\n      begin\n         Self.A := Self.A + Val;\n      end Bar;\n   end Extend;\n\n   use Extend;\n\n   Obj : D2 := (A => 15);\nbegin\n   Obj.Bar (2);\n   Obj.Foo;\nend Main;\n",
