    "text": "package P is\n   type T is tagged null record;\n\n   procedure Show (Dummy : T);\n\n   type T_New is new T with null record;\n\n   procedure Show (Dummy : T_New);\nend P;\n\nwith Ada.Text_IO; use Ada.Text_IO;\n\npackage body P is\n\n   procedure Show (Dummy : T) is\n   begin\n      Put_Line (\"Using type \"\n                & T'External_Tag);\n   end Show;\n\n   procedure Show (Dummy : T_New) is\n   begin\n      Put_Line (\"Using type \"\n                & T_New'External_Tag);\n   end Show;\n\nend P;\n",
