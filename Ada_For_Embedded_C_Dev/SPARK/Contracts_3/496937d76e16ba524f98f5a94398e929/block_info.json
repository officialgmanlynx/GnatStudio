    "text": "with Mid;\nwith Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Demo is\n   A, B, C : Integer;\nbegin\n   A := Mid (1, 2);\n   B := Mid (1, -2);\n   C := Mid (A, B);\n   Put_Line (C'Image);\nend Demo;\n\nfunction Mid (X, Y : Integer) return Integer with\n   Pre  => X + Y /= 0,\n   Post => Mid'Result > X;\n",
