    "text": "with Ada.Numerics.Elementary_Functions;  use Ada.Numerics.Elementary_Functions;\n\nprocedure Compute_Offset (K : Float; Z : out Integer; Flag : out Boolean) is\n   X : constant Float := Sin (K);\nbegin\n   if X < 0.0 then\n      Z := 0;\n      Flag := True;\n   elsif X > 0.0 then\n      Z := 1;\n      Flag := True;\n   else\n      Flag := False;\n   end if;\nend Compute_Offset;\n",
