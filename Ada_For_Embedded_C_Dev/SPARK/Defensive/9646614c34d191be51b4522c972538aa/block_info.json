    "text": "package P is\n\n   type List is array (Integer range <>) of Character;\n\n   Data : List (1 .. 100);\n   Index : Integer := 1;\n\n   procedure Read (V : out Character)\n     with Pre => Index in Data'Range;\n\nend P;\n\npackage body P is\n\n   procedure Read (V : out Character) is\n   begin\n      V := Data (Index);\n      Index := Index + 1;\n   end Read;\n\nend P;\n",
