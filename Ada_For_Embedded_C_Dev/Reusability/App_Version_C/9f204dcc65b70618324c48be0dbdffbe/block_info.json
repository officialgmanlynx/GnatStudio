    "text": "!defs.h\n#ifndef APP_VERSION\n#define APP_VERSION     1\n#endif\n\n#if APP_VERSION == 1\n#define MOD_VALUE       4\n#endif\n\n#if APP_VERSION == 2\n#define MOD_VALUE       5\n#endif\n\n!main.c\n#include <stdio.h>\n#include <stdlib.h>\n\n#include \"defs.h\"\n\nint func(int x)\n{\n    return x % MOD_VALUE;\n}\n\nint main()\n{\n    int a, b;\n\n    a = 10;\n    b = func(a);\n\n    return 0;\n}\n",
