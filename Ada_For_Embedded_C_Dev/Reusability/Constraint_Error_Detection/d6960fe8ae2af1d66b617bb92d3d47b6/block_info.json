    "text": "package P is\n   function Add_Max (A : Integer) return Integer;\nend P;\n\npackage body P is\n   function Add_Max (A : Integer) return Integer is\n   begin\n      return A + Integer'Last;\n   end Add_Max;\nend P;\n\nwith Ada.Text_IO; use Ada.Text_IO;\nwith P;           use P;\n\nprocedure Main is\n   I : Integer := Integer'Last;\nbegin\n   I := Add_Max (I);\n   Put_Line (\"I = \" & Integer'Image (I));\nend Main;\n",
