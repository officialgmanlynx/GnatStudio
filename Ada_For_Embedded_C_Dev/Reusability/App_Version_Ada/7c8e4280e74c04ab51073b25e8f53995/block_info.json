    "text": "--  ./src/app_1/app_defs.ads\n\npackage App_Defs is\n\n   Mod_Value : constant Integer := 4;\n\nend App_Defs;\n\nfunction Func (X : Integer) return Integer;\n\nwith App_Defs;\n\nfunction Func (X : Integer) return Integer is\nbegin\n    return X mod App_Defs.Mod_Value;\nend Func;\n\nwith Func;\n\nprocedure Main is\n   A, B : Integer;\nbegin\n   A := 10;\n   B := Func (A);\nend Main;\n",
