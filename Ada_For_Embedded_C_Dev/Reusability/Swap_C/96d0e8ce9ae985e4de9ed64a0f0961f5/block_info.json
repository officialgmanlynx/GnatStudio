    "text": "!main.c\n#include <stdio.h>\n#include <stdlib.h>\n\n#define SWAP(t, a, b) ({\\\n                           t tmp = a; \\\n                           a = b; \\\n                           b = tmp; \\\n                        })\n\nint main()\n{\n    int a = 10;\n    int b = 42;\n\n    printf(\"a = %d, b = %d\\n\", a, b);\n\n    SWAP (int, a, b);\n\n    printf(\"a = %d, b = %d\\n\", a, b);\n\n    return 0;\n}\n",
