    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n\n   task After is\n      entry Go (Text : String);\n   end After;\n\n   task body After is\n   begin\n      accept Go (Text : String) do\n         Put_Line (\"After: \" & Text);\n      end Go;\n   end After;\n\nbegin\n   Put_Line (\"Before\");\n   After.Go (\"Main\");\nend Main;\n",
