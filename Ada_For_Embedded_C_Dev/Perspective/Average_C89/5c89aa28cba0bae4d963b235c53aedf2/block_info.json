    "text": "!main.c\n/* The C89 version */\n\n#include <stdio.h>\n\nint average(int* list, int length)\n{\n    int i;\n    int sum = 0;\n\n    for(i = 0; i < length; ++i) {\n        sum += list[i];\n    }\n    return (sum / length);\n}\n\nint main(int argc, const char * argv[])\n{\n    int vals[] = { 2, 2, 4, 4 };\n\n    printf(\"Average: %d\\n\", average(vals, 4));\n\n    return 0;\n}\n",
