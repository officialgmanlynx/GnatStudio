    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type R is record\n      A, B : Integer;\n   end record;\n\n   type R_Access is access R;\n\n   procedure Put_R (V : R; Name : String) is\n   begin\n      Put_Line (Name & \" = (\"\n                & Integer'Image (V.A) & \", \"\n                & Integer'Image (V.B) & \")\");\n   end Put_R;\n\n   V1 : R_Access;\n   V2 : R_Access;\nbegin\n   V1 := new R;\n   V1.A := 0;\n   V2 := V1;\n   V2.A := 1;\n\n   Put_R (V1.all, \"V1\");\n   Put_R (V2.all, \"V2\");\nend Main;\n",
