    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type Arr_Type is array (Integer range <>) of Integer;\n   A1 : Arr_Type (1 .. 2);\n   A2 : Arr_Type (1 .. 2);\nbegin\n   A1 (1) := 0;\n   A1 (2) := 1;\n\n   A2 := A1;\n\n   for I in A2'Range loop\n      Put_Line (Integer'Image (A2 (I)));\n   end loop;\nend Main;\n",
