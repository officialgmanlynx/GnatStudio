    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Strong_Typing is\n   Alpha  : constant Integer := 1;\n   Beta   : constant Integer := 10;\n   Result : Float;\nbegin\n   Result := Float (Alpha) / Float (Beta);\n\n   Put_Line (Float'Image (Result));\nend Strong_Typing;\n",
