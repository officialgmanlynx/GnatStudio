    "text": "!proc.h\nvoid Proc\n    (int   Var1,\n     int * Var2,\n     int * Var3);\n\n!func.h\nint Func (int Var);\n\n!proc.c\n#include \"func.h\"\n\nvoid Proc\n    (int   Var1,\n     int * Var2,\n     int * Var3)\n{\n    *Var2 = Func (Var1);\n    *Var3 += 1;\n}\n\n!func.c\nint Func (int Var)\n{\n    return Var + 1;\n}\n\n!main.c\n#include <stdio.h>\n#include \"proc.h\"\n\nint main(int argc, const char * argv[])\n{\n    int v1, v2;\n\n    v2 = 2;\n    Proc (5, &v1, &v2);\n\n    printf(\"v1: %d\\n\", v1);\n    printf(\"v2: %d\\n\", v2);\n\n    return 0;\n}\n",
