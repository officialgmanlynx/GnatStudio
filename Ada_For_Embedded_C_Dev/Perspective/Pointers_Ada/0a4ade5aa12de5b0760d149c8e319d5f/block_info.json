    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type R is record\n      A, B : Integer;\n   end record;\n\n   procedure Put_R (V : R; Name : String) is\n   begin\n      Put_Line (Name & \" = (\"\n                & Integer'Image (V.A) & \", \"\n                & Integer'Image (V.B) & \")\");\n   end Put_R;\n\n   V1, V2 : R;\n\nbegin\n   V1.A := 0;\n   V1.B := 0;\n   V2 := V1;\n   V2.A := 1;\n\n   Put_R (V1, \"V1\");\n   Put_R (V2, \"V2\");\nend Main;\n",
