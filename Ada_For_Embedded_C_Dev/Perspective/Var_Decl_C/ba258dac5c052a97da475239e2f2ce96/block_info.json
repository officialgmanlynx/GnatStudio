    "text": "!main.c\n#include <stdio.h>\n\nint main(int argc, const char * argv[])\n{\n    // variable declarations\n    int a = 0, b = 0, c = 100, d;\n\n    // c shorthand for increment\n    a++;\n\n    // regular addition\n    d = a + b + c;\n\n    // printing the result\n    printf(\"d = %d\\n\", d);\n\n    return 0;\n}\n",
