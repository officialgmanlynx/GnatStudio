    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main\nis\n   type Int_Array is array (Natural range 1 .. 100) of Integer;\n\n   List : Int_Array;\nbegin\n\n   for I in reverse List'Range loop\n      List (I) := List'Last - I;\n   end loop;\n\n   for I in List'Range loop\n      Put (List (I)'Img & \" \");\n\n      if I mod 10 = 0 then\n         New_Line;\n      end if;\n   end loop;\n\nend Main;\n",
