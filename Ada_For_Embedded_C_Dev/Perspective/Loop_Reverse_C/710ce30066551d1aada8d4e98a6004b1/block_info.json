    "text": "!main.c\n#include <stdio.h>\n\n#define LIST_LENGTH (100)\n\nint main(int argc, const char * argv[])\n{\n    int list[LIST_LENGTH];\n\n    for(int i = LIST_LENGTH; i > 0; --i) {\n        list[i] = LIST_LENGTH - i;\n    }\n\n    for (int i = 0; i < LIST_LENGTH; ++i)\n    {\n        printf(\"%d \", list[i]);\n\n        if (i % 10 == 0) {\n            printf(\"\\n\");\n        }\n    }\n\n    return 0;\n}\n",
