    "text": "!main.c\n#include <stdio.h>\n\nint main(int argc, const char * argv[])\n{\n    unsigned char a = 0xFF;\n    char b = 0xFF;\n\n    printf(\"Does a == b?\\n\");\n    if(a == b)\n        printf(\"Yes.\\n\");\n    else\n        printf(\"No.\\n\");\n\n    printf(\"a: 0x%08X, b: 0x%08X\\n\", a, b);\n\n    return 0;\n}\n",
