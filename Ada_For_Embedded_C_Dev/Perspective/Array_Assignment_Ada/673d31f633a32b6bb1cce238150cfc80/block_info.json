    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type Arr_Type is array (Integer range <>) of Integer;\n   A1 : Arr_Type (-2 .. 42) := (others => 0);\nbegin\n   --  use a slice to assign A1 elements 11 .. 19 to 1\n   A1 (11 .. 19) := (others => 1);\n\n   Put_Line (\"---- A1 ----\");\n   for I in A1'Range loop\n      Put_Line (Integer'Image (I) & \" => \" &\n                Integer'Image (A1 (I)));\n   end loop;\nend Main;\n",
