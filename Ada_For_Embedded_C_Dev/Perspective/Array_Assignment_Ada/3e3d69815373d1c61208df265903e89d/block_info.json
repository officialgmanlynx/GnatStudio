    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type Arr_Type is array (Integer range <>) of Integer;\n   A1 : Arr_Type := (1, 2, 3, 4, 5, 6, 7, 8, 9);\nbegin\n   A1 := (1, 2, 3, others => 10);\n\n   Put_Line (\"---- A1 ----\");\n   for I in A1'Range loop\n      Put_Line (Integer'Image (I) & \" => \" &\n                Integer'Image (A1 (I)));\n   end loop;\nend Main;\n",
