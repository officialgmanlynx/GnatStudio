    "text": "with Ada.Text_IO;\n\nprocedure Main\nis\n   --  variable declaration\n   A, B : Integer := 0;\n   C    : Integer := 100;\n   D    : Integer;\nbegin\n   --  Ada does not have a shortcut format for increment like in C\n   A := A + 1;\n\n   --  regular addition\n   D := A + B + C;\n\n   --  printing the result\n   Ada.Text_IO.Put_Line (\"D =\" & D'Img);\nend Main;\n",
