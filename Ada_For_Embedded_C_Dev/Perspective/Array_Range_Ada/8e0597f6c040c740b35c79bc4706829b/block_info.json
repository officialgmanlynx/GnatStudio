    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type Arr_Type is array (Integer range <>) of Character;\n   Arr : Arr_Type (1 .. 26);\n   C : Character := 'a';\nbegin\n   for I in Arr'Range loop\n      Arr (I) := C;\n      C := Character'Succ (C);\n\n      Put (Arr (I) & \" \");\n\n      if I mod 7 = 0 then\n         New_Line;\n      end if;\n   end loop;\nend Main;\n",
