    "text": "!main.c\n#include <stdio.h>\n\nstruct R {\n    int A, B;\n};\n\nvoid print_r(const struct R *v,\n             const char     *name)\n{\n    printf(\"%s = (%d, %d)\\n\", name, v->A, v->B);\n}\n\nint main(int argc, const char * argv[])\n{\n    struct R V1, V2;\n    V1.A = 0;\n    V1.B = 0;\n    V2 = V1;\n    V2.A = 1;\n\n    print_r(&V1, \"V1\");\n    print_r(&V2, \"V2\");\n\n    return 0;\n}\n",
