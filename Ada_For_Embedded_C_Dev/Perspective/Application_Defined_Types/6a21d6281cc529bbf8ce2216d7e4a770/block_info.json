    "text": "procedure Main is\n   type Distance is new Float;\n   type Area is new Float;\n\n   D1 : Distance := 2.0;\n   D2 : Distance := 3.0;\n   A  : Area;\nbegin\n   D1 := D1 + D2; -- OK\n   D1 := D1 + A;  -- NOT OK: incompatible types for \"+\"\n   A  := D1 * D2; -- NOT OK: incompatible types for \":=\"\n   A  := Area (D1 * D2); -- OK\nend Main;\n",
