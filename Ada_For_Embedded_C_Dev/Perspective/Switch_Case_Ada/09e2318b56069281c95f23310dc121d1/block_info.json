    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main\nis\n   --  try changing the initial value to change the\n   --    output of the program\n   V : constant Integer := 0;\nbegin\n   case V is\n      when 0 =>\n         Put_Line (\"Zero\");\n      when 1 .. 9 =>\n         Put_Line (\"Positive\");\n      when 10 | 12 | 14 | 16 | 18 =>\n         Put_Line (\"Even number between 10 and 18\");\n      when others =>\n         Put_Line (\"Something else\");\n   end case;\nend Main;\n",
