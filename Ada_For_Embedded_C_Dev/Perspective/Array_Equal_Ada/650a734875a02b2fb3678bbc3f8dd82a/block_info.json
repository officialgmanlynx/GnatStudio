    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type Arr_Type is array (Integer range <>) of Integer;\n   A1 : Arr_Type (1 .. 2) := (10, 20);\n   A2 : Arr_Type (1 .. 2) := (10, 20);\nbegin\n   if A1 = A2 then\n     Put_Line (\"A1 = A2\");\n   else\n     Put_Line (\"A1 /= A2\");\n   end if;\nend Main;\n",
