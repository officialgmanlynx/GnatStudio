    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main\nis\n   type Char is range 0 .. 255;\n   type Unsigned_Char is mod 256;\n\n   A : Char := 16#FF#;\n   B : Unsigned_Char := 16#FF#;\nbegin\n\n   Put_Line (\"Does A = B?\");\n\n   if A = B then\n      Put_Line (\"Yes\");\n   else\n      Put_Line (\"No\");\n   end if;\n\nend Main;\n",
