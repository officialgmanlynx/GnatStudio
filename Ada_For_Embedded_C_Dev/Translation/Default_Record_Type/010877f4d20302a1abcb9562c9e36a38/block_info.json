    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n\n   type Rec is record\n      X : Integer := 10;\n      Y : Integer := 11;\n   end record;\n\n   R : Rec;\nbegin\n   Put_Line (\"R.X = \" & Integer'Image (R.X));\n   Put_Line (\"R.Y = \" & Integer'Image (R.Y));\nend Main;\n",
