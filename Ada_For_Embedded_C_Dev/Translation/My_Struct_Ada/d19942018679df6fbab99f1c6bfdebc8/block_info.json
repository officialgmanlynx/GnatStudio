    "text": "with Ada.Text_IO;  use Ada.Text_IO;\nwith Interfaces.C;\n\nprocedure Use_My_Struct is\n\n   type my_struct is record\n     A : Interfaces.C.int;\n     B : Interfaces.C.int;\n   end record;\n   pragma Convention (C, my_struct);\n\n   V : my_struct := (A => 1, B => 2);\nbegin\n   Put_Line (\"V = (\"\n             & Interfaces.C.int'Image (V.A)\n             & Interfaces.C.int'Image (V.B)\n             & \")\");\nend Use_My_Struct;\n",
