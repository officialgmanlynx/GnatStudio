
project Main is

   for Main use ("bitfield_int_array.c");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O0");
      for Switches ("Ada") use ("-gnata");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
      for Global_Configuration_Pragmas use "main.adc";
   end Builder;

end Main;
