    "text": "!bitfield_int_array.c\n#include <stdio.h>\n\nint main(int argc, const char * argv[])\n{\n    int i;\n    int a[2] = {0, 0};\n\n    a[0] = a[0] | (1 << 2);\n\n    for (i = 0; i < 2; i++)\n    {\n        printf(\"a[%d] = %d\\n\", i, a[i]);\n    }\n\n    return 0;\n}\n",
