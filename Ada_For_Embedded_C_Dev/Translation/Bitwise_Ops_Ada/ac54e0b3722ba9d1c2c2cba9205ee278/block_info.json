    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Main is\n   type Value_Type is mod 2 ** 32;\n   pragma Provide_Shift_Operators (Value_Type);\n\n   Value : Value_Type;\nbegin\n   Value := Shift_Left (2, 1) or 1;\n   Put_Line (\"Value = \" & Value_Type'Image (Value));\nend Main;\n",
