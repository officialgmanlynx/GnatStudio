    "text": "with Interfaces.C;\n\nprocedure Use_My_Struct is\n\n   type my_struct is record\n     A : Interfaces.C.int;\n     B : Interfaces.C.int;\n   end record;\n   pragma Convention (C, my_struct);\n\n   procedure Call (V : my_struct);\n   pragma Import (C, Call, \"call\"); -- Third argument optional\n\n   V : my_struct := (A => 1, B => 2);\nbegin\n   Call (V);\nend Use_My_Struct;\n",
