    "text": "!main.c\n#include <stdio.h>\n\nstruct Data {\n    int prev, curr;\n};\n\nvoid init_data(struct Data *d)\n{\n    d->prev = 0;\n    d->curr = 1;\n}\n\nstruct Data get_init_data()\n{\n    struct Data d  = { 0, 1 };\n\n    return d;\n}\n\nint main(int argc, const char * argv[])\n{\n    struct Data D1;\n\n    D1 = get_init_data();\n\n    init_data(&D1);\n\n    return 0;\n}\n",
