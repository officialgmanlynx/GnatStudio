    "text": "!main.c\n#include <stdio.h>\n\nint main(int argc, const char * argv[])\n{\n    int a = 8, b = 0, res;\n\n    if (b != 0) {\n        res = a / b;\n\n        // printing the result\n        printf(\"res = %d\\n\", res);\n    }\n    else\n    {\n        // printing error message\n        printf(\"Error: cannot calculate value (division by zero)\\n\");\n    }\n\n    return 0;\n}\n",
