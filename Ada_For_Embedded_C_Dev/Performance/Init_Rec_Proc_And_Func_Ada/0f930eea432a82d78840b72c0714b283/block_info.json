    "text": "procedure Init_Record is\n\n   type Data is record\n      Prev : Integer;\n      Curr : Integer;\n   end record;\n\n   procedure Init (D : out Data) is\n   begin\n      D := (Prev => 0, Curr => 1);\n   end Init;\n\n   function Init return Data is\n      D : constant Data := (Prev => 0, Curr => 1);\n   begin\n      return D;\n   end Init;\n\n   D1 : Data;\n\n   pragma Unreferenced (D1);\nbegin\n   D1 := Init;\n\n   Init (D1);\nend Init_Record;\n",
