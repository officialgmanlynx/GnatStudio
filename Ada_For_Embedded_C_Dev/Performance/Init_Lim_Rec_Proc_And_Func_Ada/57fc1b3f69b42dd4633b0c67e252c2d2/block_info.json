    "text": "procedure Init_Limited_Record is\n\n   type Data is limited record\n      Prev : Integer;\n      Curr : Integer;\n   end record;\n\n   function Init return Data is\n   begin\n      return D : Data do\n         D.Prev := 0;\n         D.Curr := 1;\n      end return;\n   end Init;\n\n   D1 : Data := Init;\n\n   pragma Unreferenced (D1);\nbegin\n   null;\nend Init_Limited_Record;\n",
