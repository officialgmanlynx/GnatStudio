    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Division_By_Zero is\n   A   : Integer := 8;\n   B   : Integer := 0;\n   Res : Integer;\nbegin\n   Res := A / B;\n\n   Put_Line (\"Res = \" & Integer'Image (Res));\nend Show_Division_By_Zero;\n",
