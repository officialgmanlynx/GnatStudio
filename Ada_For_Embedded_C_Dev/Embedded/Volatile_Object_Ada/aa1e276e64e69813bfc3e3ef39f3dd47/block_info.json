    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Volatile_Object is\n   Val : Long_Float with Volatile;\nbegin\n   Val := 0.0;\n   for I in 0 .. 999 loop\n      Val := Val + 2.0 * Long_Float (I);\n   end loop;\n\n   Put_Line (\"Val: \" & Long_Float'Image (Val));\nend Show_Volatile_Object;\n",
