    "text": "!main.c\n#include <stdio.h>\n\nint main(int argc, const char * argv[])\n{\n    volatile double val = 0.0;\n    int i;\n\n    for (i = 0; i < 1000; i++)\n    {\n        val += i * 2.0;\n    }\n    printf (\"val: %5.3f\\n\", val);\n\n    return 0;\n}\n",
