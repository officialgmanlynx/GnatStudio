    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Fixed_Point_Op is\n   type TQ31 is delta 2.0 ** (-31) range -1.0 .. 1.0 - 2.0 ** (-31);\n\n   A, B, R : TQ31;\nbegin\n   A := 0.25;\n   B := 0.50;\n   R := A + B;\n   Put_Line (\"R is \" & TQ31'Image (R));\nend Fixed_Point_Op;\n",
