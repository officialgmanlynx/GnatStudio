    "text": "!f.h\n#include <stdint.h>\n\nvoid f ( int b, uint16_t *p );\n\n!f.c\n#include \"f.h\"\n\nvoid f ( int b, uint16_t *p )\n{\n  if ( b )\n  {\n     *p = 3U;\n  }\n}\n\n!g.c\n#include <stdint.h>\n#include \"f.h\"\n\nstatic void g (void)\n{\n   uint16_t u;\n\n   f ( 0, &u );\n\n   if ( u == 3U )\n   {\n      /* Non-compliant use - \"u\" has not been assigned a value. */\n   }\n}\n",
