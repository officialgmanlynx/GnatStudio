    "text": "with Interfaces; use Interfaces;\n\npackage Init is\n   U : Unsigned_16;\n   procedure F (B : Boolean);\n   procedure G with Global => (Output => U);\nend Init;\n\npackage body Init is\n\n   procedure F (B : Boolean) is\n   begin\n      if B then\n         U := 3;\n      end if;\n   end F;\n\n   procedure G is\n   begin\n      F (False);\n\n      if U = 3 then\n         null;\n      end if;\n   end G;\n\nend Init;\n\nwith Init;\n\nprocedure Call_Init is\nbegin\n   Init.G;\nend Call_Init;\n",
