    "text": "with Interfaces; use Interfaces;\n\npackage Init is\n   procedure F (B : Boolean; P : out Unsigned_16);\n   procedure G;\nend Init;\n\npackage body Init is\n\n   procedure F (B : Boolean; P : out Unsigned_16) is\n   begin\n      if B then\n         P := 3;\n      else\n         P := 0;\n      end if;\n   end F;\n\n   procedure G is\n      U : Unsigned_16;\n   begin\n      F (False, U);\n\n      if U = 3 then\n         null;\n      end if;\n   end G;\n\nend Init;\n",
