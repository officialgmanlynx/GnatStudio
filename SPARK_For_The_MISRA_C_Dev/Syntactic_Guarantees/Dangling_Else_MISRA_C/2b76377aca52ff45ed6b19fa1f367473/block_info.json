    "text": "!main.c\n#include <stdio.h>\n\nint absval (int x) {\n   int result = x;\n   if (x >= 0) {\n      if (x == 0) {\n         result = 0;\n      }\n   } else {\n      result = -x;\n   }\n   return result;\n}\n\nint main() {\n   printf(\"absval(5) = %d\\n\", absval(5));\n   printf(\"absval(0) = %d\\n\", absval(0));\n   printf(\"absval(-10) = %d\\n\", absval(-10));\n}\n",
