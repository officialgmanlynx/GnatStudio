    "text": "procedure Well_Formed_Loop (C : Boolean) is\n   Flag : Boolean := False;\nbegin\n   for I in 0 .. 4 loop\n      exit when not Flag;\n\n      if C then\n         Flag := True;\n      end if;\n\n      I := I + 3;  --  ERROR\n   end loop;\nend Well_Formed_Loop;\n",
