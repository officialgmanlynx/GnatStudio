    "text": "package Volatile_Read is\n   X : Integer with Volatile;\n   procedure P (Y : out Integer);\nend Volatile_Read;\n\npackage body Volatile_Read is\n   procedure P (Y : out Integer) is\n      X1 : constant Integer := X;\n      X2 : constant Integer := X;\n   begin\n      Y := X1 - X2;\n   end P;\nend Volatile_Read;\n",
