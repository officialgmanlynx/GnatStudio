    "text": "!main.c\n#include <stdio.h>\n\nvoid decrease_until_one_is_null (int *x, int *y) {\n   if (x == 0 || y == 0) {\n      return;\n   }\n   while (--*x != 0 && --*y != 0) {\n      // nothing\n   }\n}\n\nint main() {\n   int x = 42, y = 42;\n   decrease_until_one_is_null (&x, &y);\n   printf(\"x = %d, y = %d\\n\", x, y);\n   return 0;\n}\n",
