    "line_end": 342,
    "text": "!main.c\n#include <stdio.h>\n\nvoid assign_int (int *p) {\n   *p = 42;\n}\n\nvoid assign_float (float *p) {\n   *p = 42.0;\n}\n\ntypedef void (*assign_fun)(void *p);\n\nvoid assign(assign_fun fun, void *p) {\n   fun(p);\n}\n\nint main() {\n   int i;\n   float f;\n   assign((assign_fun)&assign_int, &i);\n   assign((assign_fun)&assign_float, &f);\n   printf(\"i = %d; f = %f\\n\", i, f);\n}\n",
