    "text": "procedure Bad_Conversions is\n   pragma Warnings (Off);\n   F : Float := 0.0;\n   I : Integer := 0;\n   type Animal is (Ape, Bee, Cat);\n   type My_Animal is new Animal; -- derived type\n   A : Animal := Cat;\n   M : My_Animal := Bee;\n   B : Boolean := True;\n   C : Character := 'a';\nbegin\n   F := Float (I);       --  OK\n   I := Integer (A);     --  ERROR\n   A := Animal (B);      --  ERROR\n   M := My_Animal (A);   --  OK\n   B := Boolean (C);     --  ERROR\n   C := Character (F);   --  ERROR\nend Bad_Conversions;\n",
