    "text": "!main.c\n#include <stdio.h>\n\nint count(int *p, int len, int v) {\n   int count = 0;\n   while (len--) {\n      if (*p++ == v) {\n         count++;\n      }\n   }\n   return count;\n}\n\nint main() {\n   int p[5] = {0, 3, 9, 3, 3};\n   int c = count(p, 5, 3);\n   printf(\"value 3 is seen %d times in p\\n\", c);\n   return 0;\n}\n",
