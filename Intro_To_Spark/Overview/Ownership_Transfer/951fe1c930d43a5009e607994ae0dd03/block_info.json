    "text": "procedure Ownership_Transfer is\n   type Int_Ptr is access Integer;\n   X     : Int_Ptr;\n   Y     : Int_Ptr;\n   Dummy : Integer;\nbegin\n   X     := new Integer'(1);\n   X.all := X.all + 1;\n   Y     := X;\n   Y.all := Y.all + 1;\n   X.all := X.all + 1;  --  illegal\n   X.all := 1;          --  illegal\n   Dummy := X.all;      --  illegal\nend Ownership_Transfer;\n",
