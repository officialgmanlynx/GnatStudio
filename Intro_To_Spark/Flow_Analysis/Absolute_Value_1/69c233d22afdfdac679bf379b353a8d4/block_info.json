    "text": "procedure Absolute_Value\n  (X :     Integer;\n   R : out Natural)\nis\nbegin\n   if X < 0 then\n      R := -X;\n   end if;\n   if X >= 0 then\n      R := X;\n   end if;\n   --  flow analysis doesn't know that R is initialized\nend Absolute_Value;\n",
