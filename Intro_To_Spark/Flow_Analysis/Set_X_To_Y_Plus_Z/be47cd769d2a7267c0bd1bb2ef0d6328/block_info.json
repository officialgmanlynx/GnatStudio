    "text": "procedure Set_X_To_Y_Plus_Z\n  (Y, Z     :     Natural;\n   X        : out Natural;\n   Overflow : out Boolean)\nis\nbegin\n   if Natural'Last - Z < Y then\n      Overflow := True; -- X should be initialized on every path\n   else\n      Overflow := False;\n      X := Y + Z;\n   end if;\nend Set_X_To_Y_Plus_Z;\n",
