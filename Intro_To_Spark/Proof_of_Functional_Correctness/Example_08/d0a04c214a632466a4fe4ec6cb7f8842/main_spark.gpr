
project Main_Spark is

   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O0");
      for Switches ("Ada") use ("-gnata");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
      for Global_Configuration_Pragmas use "main_spark.adc";
   end Builder;

end Main_Spark;
