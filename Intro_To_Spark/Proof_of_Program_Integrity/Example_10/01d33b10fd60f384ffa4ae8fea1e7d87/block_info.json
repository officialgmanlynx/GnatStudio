    "text": "procedure Compute (X : in out Integer) with\n  Contract_Cases => ((X in    0 ..  199) => X >= X'Old,\n                     (X in -199 ..   -1) => X <= X'Old,\n                      X >=  200           => X =  200,\n                      X <  -200           => X = -200)\nis\nbegin\n   if X in -100 .. 100 then\n      X := X * 2;\n   elsif X in 0 .. 199 then\n      X := X + 1;\n   elsif X in -199 .. 0 then\n      X := X - 1;\n   elsif X >= 200 then\n      X := 200;\n   else\n      X := -200;\n   end if;\nend Compute;\n",
