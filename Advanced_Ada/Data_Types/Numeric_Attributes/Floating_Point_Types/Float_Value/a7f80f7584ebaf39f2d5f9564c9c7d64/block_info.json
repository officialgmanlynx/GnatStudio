    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Float_Value is\n   package F_IO is new\n     Ada.Text_IO.Float_IO (Float);\n\n   V : Float;\nbegin\n   F_IO.Default_Fore := 3;\n   F_IO.Default_Aft  := 1;\n   F_IO.Default_Exp  := 0;\n\n   V := 1.0E+15;\n   Put (\"1.0E+15 = \");\n   F_IO.Put (Item => V);\n   New_Line;\n\nend Show_Float_Value;\n",
