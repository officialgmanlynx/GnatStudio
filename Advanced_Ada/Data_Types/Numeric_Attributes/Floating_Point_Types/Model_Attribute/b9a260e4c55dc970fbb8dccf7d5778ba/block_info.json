    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Model_Attribute is\n   package F_IO is new\n     Ada.Text_IO.Float_IO (Float);\n\n   V : Float;\nbegin\n   F_IO.Default_Fore := 3;\n   F_IO.Default_Aft  := 1;\n   F_IO.Default_Exp  := 0;\n\n   Put_Line\n     (\"Original value: 1_000_000_000_000_000.0\");\n\n   V := 1.0E+15;\n   Put (\"Model value:    \");\n   F_IO.Put (Item => V);\n   New_Line;\n\n   V := 1.0E+15 - Float'Model (1.0E+15);\n   Put (\"Difference:     \");\n   F_IO.Put (Item => V);\n   New_Line;\n\nend Show_Model_Attribute;\n",
