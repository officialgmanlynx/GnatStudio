    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_String_Literals_With_Quotes is\n   S1 : String := \"Hello\";\n   S2 : String := \"World\";\nbegin\n   Put_Line (\"  \"\" \" & S1\n   --           ^^\n   --       Quotation marks\n             & \" \" & S2 & \" \"\"  \");\n   --                       ^^\n   --       Quotation marks\n\n   Put_Line (\"\"\"Hello World!\"\"\");\n   --         ^^            ^^\n   --          Quotation marks\n\n   Put_Line (\"\"\"\"\"\");\n   --         ^^^^\n   --    Quotation marks\nend Show_String_Literals_With_Quotes;\n",
