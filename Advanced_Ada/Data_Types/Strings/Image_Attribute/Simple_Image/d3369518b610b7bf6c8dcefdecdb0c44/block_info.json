    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Simple_Image is\n   type Status is (Unknown, Off, On);\n\n   V : Float;\n   S : Status;\nbegin\n   V := 10.0;\n   S := Unknown;\n\n   Put_Line (\"V: \" & Float'Image (V));\n   Put_Line (\"S: \" & Status'Image (S));\nend Show_Simple_Image;\n",
