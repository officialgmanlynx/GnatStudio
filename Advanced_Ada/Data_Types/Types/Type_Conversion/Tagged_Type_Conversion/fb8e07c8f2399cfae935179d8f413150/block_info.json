    "text": "with Ada.Text_IO; use Ada.Text_IO;\nwith Points;      use Points;\n\nprocedure Show_Conversion is\n   P_1D : Point_1D;\n   P_3D : Point_3D;\nbegin\n   P_3D := (X => 0.1, Y => 0.5, Z => 0.3);\n   P_1D := Point_1D (P_3D);\n\n   Put (\"P_3D : \");\n   Display (P_3D);\n\n   Put (\"P_1D : \");\n   Display (P_1D);\nend Show_Conversion;\n",
