    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Conversion is\n   F : Float   := 1.0;\n   I : Integer := 2;\nbegin\n   I := Integer (F);\n\n   Put_Line (\"I : \"\n             & I'Image);\n\n   I := 4;\n   F := Float (I);\n\n   Put_Line (\"F :   \"\n             & F'Image);\nend Show_Conversion;\n",
