    "text": "package Custom_Rec is\n\n   type Rec is record\n      X : Integer;\n   end record;\n\n   function To_Integer (R : Rec)\n                        return Integer is\n     (R.X);\n\nend Custom_Rec;\n\nwith Ada.Text_IO; use Ada.Text_IO;\nwith Custom_Rec;  use Custom_Rec;\n\nprocedure Show_Conversion is\n   R : Rec;\n   I : Integer;\nbegin\n   R := (X => 2);\n   I := To_Integer (R);\n\n   Put_Line (\"I : \" & I'Image);\nend Show_Conversion;\n",
