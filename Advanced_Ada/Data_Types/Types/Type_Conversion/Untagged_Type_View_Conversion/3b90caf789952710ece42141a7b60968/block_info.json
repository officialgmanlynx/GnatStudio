    "text": "with Ada.Text_IO; use Ada.Text_IO;\nwith Double;\n\nprocedure Show_Conversion is\n   I : Integer;\nbegin\n   I := 2;\n   Put_Line (\"I : \"\n             & I'Image);\n\n   declare\n      F : Float := Float (I);\n   begin\n      Double (F);\n      I := Integer (F);\n   end;\n   Put_Line (\"I : \"\n             & I'Image);\nend Show_Conversion;\n",
