    "text": "package Show_Root_Integer_Real is\n\n   type Score is range 0 .. 10;\n   --  Type Score is derived from\n   --  the root integer type.\n\n   type Real_Score is\n     digits 10 range 0.0 .. 10.0;\n   --  Type Real_Score is derived from\n   --  the root real type.\n\nend Show_Root_Integer_Real;\n",
