    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Universal_Access is\n   I : aliased Integer;\n   A : access Integer := I'Access;\n   B : access Integer := I'Access;\nbegin\n   if A = B then\n      Put_Line (\"A = B\");\n   else\n      Put_Line (\"A /= B\");\n   end if;\nend Show_Universal_Access;\n",
