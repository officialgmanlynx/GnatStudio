    "text": "with Ada.Text_IO;         use Ada.Text_IO;\nwith Enumeration_Example; use Enumeration_Example;\n\nprocedure Show_Renaming is\n   D1 : constant Day := Mon;\n   D2 : constant Day := Monday;\nbegin\n   if D1 = D2 then\n      Put_Line (\"D1 = D2\");\n      Put_Line (Day'Image (D1)\n                & \" =  \"\n                & Day'Image (D2));\n   end if;\nend Show_Renaming;\n",
