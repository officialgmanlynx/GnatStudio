    "text": "with Ada.Text_IO; use Ada.Text_IO;\nwith Colors;      use Colors;\n\nprocedure Red_Colors is\n   C1 : constant Color         := Red;\n   --  Using Red from Color\n\n   C2 : constant Primary_Color := Red;\n   --  Using Red from Primary_Color\nbegin\n   if C1 = Red then\n      Put_Line (\"C1 = Red\");\n   end if;\n   if C2 = Red then\n      Put_Line (\"C2 = Red\");\n   end if;\nend Red_Colors;\n",
