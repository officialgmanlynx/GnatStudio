    "text": "package Unconstrained_Types is\n\n   type Integer_Array is\n     array (Positive range <>) of Integer;\n\n   type Simple_Record (Extended : Boolean) is\n   record\n      V : Integer;\n      case Extended is\n         when False =>\n            null;\n         when True  =>\n            V_Float : Float;\n      end case;\n   end record;\n\nend Unconstrained_Types;\n",
