
project Main is

   for Main use ("show_big_real_big_integer_conversion.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O0");
      for Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
      for Global_Configuration_Pragmas use "main.adc";
   end Builder;

end Main;
