    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nwith Custom_Fixed_Point;\nuse  Custom_Fixed_Point;\n\nprocedure Show_Mixing_Fixed_Point is\n   A : TQ7_24;\n   B : TQ31;\nbegin\n   A := 1.0;\n   B := 0.222_222_222_222_222;\n   Put_Line (\"A = \" &\n             A'Image);\n   Put_Line (\"B = \" &\n             B'Image);\n\n   Put_Line (\"--------------\");\n   Put_Line (\"A := A + B\");\n   A := A + TQ7_24 (B);\n   Put_Line (\"A = \" &\n             A'Image);\nend Show_Mixing_Fixed_Point;\n",
