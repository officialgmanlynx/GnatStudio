    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_String_Representation is\n   D : constant := 2.0 ** (-15);\n\n   type TQ15 is\n     delta D\n     range -1.0 .. 1.0 - D;\n\n   procedure Show (V : TQ15) is\n   begin\n      Put_Line (\"TQ15'Image  : \"\n                & V'Image);\n      Put_Line (\"Float'Image : \"\n                & Float (V)'Image);\n      Put_Line (\"----------\");\n   end Show;\nbegin\n   Show (0.25);\n   Show (TQ15'Last);\n   Show (0.1);\nend Show_String_Representation;\n",
