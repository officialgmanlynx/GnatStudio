    "text": "with Ada.Text_IO; use Ada.Text_IO;\nwith System;\n\nprocedure Show_Fine_Delta is\n   type Fraction is\n     delta System.Fine_Delta\n     range -1.0 .. 1.0 - System.Fine_Delta;\nbegin\n   Put_Line (\"Fraction'Small = \"\n             & Fraction'Small'Image);\n   Put_Line (\"Fraction'Size  = \"\n             & Fraction'Size'Image);\nend Show_Fine_Delta;\n",
