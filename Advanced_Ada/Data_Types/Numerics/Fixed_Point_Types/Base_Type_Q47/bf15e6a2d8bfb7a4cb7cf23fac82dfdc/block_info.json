    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Full_Range_Base_Type is\n   D : constant := 2.0 ** (-31);\n\n   type Fixed_128_Bits is\n     delta D\n     range -1.0 .. 1.0 - D\n     with Size => 128;\nbegin\n   Put_Line (\"The size of \"\n             & \"Fixed_128_Bits is \"\n             & Fixed_128_Bits'Size'Image\n             & \" bits\");\nend Show_Full_Range_Base_Type;\n",
