    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nwith Custom_Decimal_Types;\nuse  Custom_Decimal_Types;\n\nprocedure Show_Mixing_Decimal_Types is\n   A : Short_Decimal;\n   B : Decimal;\nbegin\n   A := 1000.0;\n   B := 0.19;\n   Put_Line (\"A = \" &\n             A'Image);\n   Put_Line (\"B = \" &\n             B'Image);\n   Put_Line (\"----------\");\n\n   A := A * B;\n   Put_Line (\"A := A * B\");\n   Put_Line (\"A = \" &\n             A'Image);\nend Show_Mixing_Decimal_Types;\n",
