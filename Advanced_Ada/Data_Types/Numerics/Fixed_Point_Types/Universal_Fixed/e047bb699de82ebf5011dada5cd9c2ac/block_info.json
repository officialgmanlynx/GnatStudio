    "text": "package Custom_Fixed_Point is\n   D_15 : constant := 2.0 ** (-15);\n   D_24 : constant := 2.0 ** (-24);\n   D_31 : constant := 2.0 ** (-31);\n\n   type TQ15 is\n     delta D_15\n     range -1.0 .. 1.0 - D_15;\n\n   type TQ31 is\n     delta D_31\n     range -1.0 .. 1.0 - D_31;\n\n   type TQ7_24 is\n     delta  D_24\n     range -2.0 ** 7 ..\n            2.0 ** 7   - D_24;\n\nend Custom_Fixed_Point;\n",
