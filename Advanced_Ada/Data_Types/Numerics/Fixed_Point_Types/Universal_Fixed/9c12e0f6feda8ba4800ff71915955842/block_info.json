    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nwith Custom_Fixed_Point;\nuse  Custom_Fixed_Point;\n\nprocedure Show_Universal_Fixed is\n   Acc : TQ7_24;\n   A   : TQ31;\nbegin\n   Acc := 1.0;\n   A   := 0.75;\n   Put_Line (\"A    = \" & A'Image);\n   Put_Line (\"Acc  = \" & Acc'Image);\n   Put_Line (\"--------------\");\n\n   Put_Line (\"Acc := Acc / A\");\n   Acc := Acc / A;\n   --     ^^^^^^^\n   --  Using universal fixed point\n\n   Put_Line (\"Acc  = \" & Acc'Image);\nend Show_Universal_Fixed;\n",
