    "text": "package Angles is\n\n   D : constant := 0.2;\n   --  Note: D is not a power of two.\n\n   type Angle is\n     delta D\n       range 0.0 .. 360.0 - D;\n\n   type Int_Angle is\n     range -2 ** (Angle'Size - 1) ..\n            2 ** (Angle'Size - 1) - 1;\n\n   type Angle_Adj is\n     delta D\n       range 0.0 .. 360.0 - D\n     with Small => D;\n\n   type Int_Angle_Adj is\n     range -2 ** (Angle_Adj'Size - 1) ..\n            2 ** (Angle_Adj'Size - 1) - 1;\n\nend Angles;\n",
