    "text": " with Ada.Text_IO;\n\n procedure Ada_Numeric_Literals is\n    Pi   : constant :=\n      3.14159_26535_89793_23846_26433_83279_50288;\n\n    Pi2  : constant :=\n      3.14159265358979323846264338327950288;\n\n    Z    : constant := Pi - Pi2;\n    pragma Assert (Z = 0.0);\n\n    use Ada.Text_IO;\n begin\n    Put_Line (\"Z = \" & Float'Image (Z));\n end Ada_Numeric_Literals;\n",
