    "text": "package Unknown_Discriminants is\n\n   --   Private type\n   type Rec (<>) is\n     private;\n\n   --   Tagged private type\n   type Tagged_Rec (<>) is\n     tagged private;\n\n   --   Incomplete type\n   type T_Incomplete (<>);\n\n   type T_Incomplete (<>) is\n     private;\n\nprivate\n\n   type Rec is\n     null record;\n\n   type Tagged_Rec is\n     tagged null record;\n\n   type T_Incomplete is\n     null record;\n\nend Unknown_Discriminants;\n",
