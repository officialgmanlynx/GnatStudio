    "text": "package Subtype_Coverage is\n\n   type Var_Rec (Value : Integer) is\n   record\n      case Value is\n         when Integer'First .. -1 =>\n            null;\n         when 0 .. 100 =>\n            I : Integer;\n         when 101 .. Integer'Last =>\n            null;\n      end case;\n   end record;\n\nend Subtype_Coverage;\n",
