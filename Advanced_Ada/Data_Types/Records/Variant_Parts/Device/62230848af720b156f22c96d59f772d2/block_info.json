    "text": "with Devices; use Devices;\n\nprocedure Show_Device is\n   D : Device;\n   I : Device_Info;\nbegin\n   Turn_On (D);\n\n   if D.State = On then\n      I := Current_Info (D);\n   end if;\n\n   Turn_Off (D);\n\n   if D.State = On then\n      I := Current_Info (D);\n   end if;\nend Show_Device;\n",
