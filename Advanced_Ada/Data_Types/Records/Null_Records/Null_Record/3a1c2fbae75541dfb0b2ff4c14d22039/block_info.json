    "text": "package Null_Recs is\n\n   type Null_Record is null record;\n\n   function \"+\" (A, B : Null_Record)\n                 return Null_Record;\n\nend Null_Recs;\n\npackage body Null_Recs is\n\n   function \"+\" (A, B : Null_Record)\n                 return Null_Record\n   is\n      pragma Unreferenced (A, B);\n   begin\n      return (null record);\n   end \"+\";\n\nend Null_Recs;\n\nwith Null_Recs; use Null_Recs;\n\nprocedure Show_Null_Rec is\n   A, B : Null_Record;\nbegin\n   B := A + A;\n   A := A + B;\nend Show_Null_Rec;\n",
