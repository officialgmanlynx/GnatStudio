    "text": "package Mutability is\n\n   type T_Non_Mutable\n     (L : Positive;\n      M : Positive) is\n     null record;\n\n   type T_Mutable\n     (L : Positive := 1;\n      M : Positive := 2) is\n     null record;\n\nend Mutability;\n\nwith Mutability; use Mutability;\n\nprocedure Show_Mutable_Subtype_Assignment is\n   NM_1 : T_Non_Mutable (5, 6);\n   NM_2 : T_Non_Mutable (7, 8);\n\n   M_1  : T_Mutable (7, 8);\n   M_2  : T_Mutable;\nbegin\n   NM_2 := NM_1;  --  ERROR!\n   M_2  := M_1;   --  OK\nend Show_Mutable_Subtype_Assignment;\n",
