    "text": "package Recs is\n\n   type T (L : Positive;\n           M : Positive) is\n     null record;\n\nend Recs;\n\nwith Ada.Text_IO; use Ada.Text_IO;\n\nwith Recs;        use Recs;\n\nprocedure Show_Object_Declaration is\n   A : T (L => 5, M => 6);\n   B : T (7, 8);\nbegin\n   Put_Line (\"A.L = \"\n             & A.L'Image);\n   Put_Line (\"A.M = \"\n             & A.M'Image);\n   Put_Line (\"B.L = \"\n             & B.L'Image);\n   Put_Line (\"B.M = \"\n             & B.M'Image);\nend Show_Object_Declaration;\n",
