    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nwith Registers;   use Registers;\n\nprocedure Show_Register is\n   WR : Window_Register;\nbegin\n   --  Nonatomic full-access assignment\n   --  using an aggregate:\n   WR := (Horizontal_Cnt => 800,\n          Vertical_Cnt   => 600,\n          Refresh_Needed => True,\n          others         => <>);\n\n   Show (WR);\nend Show_Register;\n",
