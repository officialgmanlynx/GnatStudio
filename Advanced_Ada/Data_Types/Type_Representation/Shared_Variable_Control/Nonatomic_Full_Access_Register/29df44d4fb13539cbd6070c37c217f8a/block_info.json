    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nwith Registers;   use Registers;\n\nprocedure Show_Registers is\n   WR : Window_Register :=\n          (Horizontal_Cnt => 800,\n           Vertical_Cnt   => 600,\n           others         => <>);\nbegin\n   --  Delta assignment\n   WR := (WR with delta\n               Vertical_Cnt   => 800,\n               Refresh_Needed => True);\n\n   Show (WR);\nend Show_Registers;\n",
