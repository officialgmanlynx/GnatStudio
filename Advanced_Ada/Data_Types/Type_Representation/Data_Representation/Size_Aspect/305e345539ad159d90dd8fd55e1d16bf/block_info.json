    "text": "package Custom_Types is\n\n   type My_Int is range 0 .. 127\n     with Size => 24;\n\nend Custom_Types;\n\nwith Ada.Text_IO;  use Ada.Text_IO;\n\nwith Custom_Types; use Custom_Types;\n\nprocedure Show_Sizes is\nbegin\n   Put_Line (\"Size of My_Int: \"\n             & My_Int'Size'Image\n             & \" bits\");\nend Show_Sizes;\n",
