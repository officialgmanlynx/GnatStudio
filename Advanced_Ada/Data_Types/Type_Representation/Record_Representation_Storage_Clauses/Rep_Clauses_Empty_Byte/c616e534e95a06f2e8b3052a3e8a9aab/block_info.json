    "text": "package P is\n\n   type R is record\n      A : Integer;\n      B : Integer;\n   end record;\n\n   for R use record\n      A at 0 range 0 .. 31;\n      B at 5 range 0 .. 31;\n   end record;\n\nend P;\n\nwith Ada.Text_IO; use Ada.Text_IO;\n\nwith P;           use P;\n\nprocedure Show_Empty_Byte is\nbegin\n   Put_Line (\"R'Size:        \"\n             & R'Size'Image);\n   Put_Line (\"R'Object_Size: \"\n             & R'Object_Size'Image);\nend Show_Empty_Byte;\n",
