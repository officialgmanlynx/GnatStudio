    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nwith P;           use P;\n\nprocedure Show_Simple_Reg is\n   Default : constant Simple_Reg :=\n               (S     => Ready,\n                Error => False,\n                V1    => 0);\n\n   R : Simple_Reg := Default;\nbegin\n   Put_Line (\"R.S:  \" & R.S'Image);\n\n   R.V1 := 4;\n\n   Put_Line (\"R.V1: \" & R.V1'Image);\nend Show_Simple_Reg;\n",
