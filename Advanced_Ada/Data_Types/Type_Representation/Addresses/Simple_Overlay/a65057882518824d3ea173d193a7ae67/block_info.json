    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Simple_Overlay is\n   type State is (Off, State_1, State_2)\n     with Size => Integer'Size;\n\n   for State use (Off     => 0,\n                  State_1 => 32,\n                  State_2 => 64);\n\n   S : State;\n   I : Integer\n     with Address => S'Address, Import, Volatile;\nbegin\n   S := State_2;\n   Put_Line (\"I = \" & Integer'Image (I));\nend Simple_Overlay;\n",
