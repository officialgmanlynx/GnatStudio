    "text": "!main.c\n#include <stdio.h>\n\nint main(int argc, const char * argv[])\n{\n    int i;\n    int arr[10];\n\n    int *a = arr;\n    /* int *a = &arr[0]; */\n\n    for (i = 0; i < 10; i++)\n    {\n        *a++ = i;\n        printf(\"curr address: %p\\n\", a);\n    }\n\n    for (i = 0; i < 10; i++)\n    {\n        printf(\"arr[%d]: %d\\n\", i, arr[i]);\n    }\n\n    return 0;\n}\n",
