    "text": "with Points; use Points;\n\nprocedure Show_Record_Aggregates is\n   P : Point_3D;\nbegin\n   --  Specifying X component;\n   --  using 42 for all\n   --  other components.\n   P := (X      => 42,\n         others => 100);\n   Display (P);\n\n   --  Specifying all components\n   P := (others => 256);\n   Display (P);\nend Show_Record_Aggregates;\n",
