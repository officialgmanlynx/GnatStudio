    "text": "with Points; use Points;\n\nprocedure Show_Record_Aggregates is\n   P : Point_3D;\nbegin\n   --  Positional component association\n   P := (0, 1, 2);\n\n   Display (P);\n\n   --  Named component association\n   P := (X => 3,\n         Y => 4,\n         Z => 5);\n\n   Display (P);\nend Show_Record_Aggregates;\n",
