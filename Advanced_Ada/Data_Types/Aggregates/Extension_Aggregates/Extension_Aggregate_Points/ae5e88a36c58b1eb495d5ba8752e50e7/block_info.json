    "text": "with Points; use Points;\n\nprocedure Show_Points is\n   P_2D : Point_2D;\n   P_3D : Point_3D;\nbegin\n   P_3D := (X => 0.5, Y => 0.7, Z => 0.3);\n   Display (P_3D);\n\n   P_2D := (Point_1D (P_3D) with Y => 0.3);\n   Display (P_2D);\nend Show_Points;\n",
