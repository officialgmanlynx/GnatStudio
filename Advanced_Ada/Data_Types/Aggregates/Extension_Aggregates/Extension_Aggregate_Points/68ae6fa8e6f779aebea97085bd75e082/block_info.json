    "text": "with Points; use Points;\n\nprocedure Show_Points is\n   P_1D : Point_1D;\n   P_2D : Point_2D;\nbegin\n   P_1D := (X => 0.5);\n   Display (P_1D);\n\n   Point_1D (P_2D) := P_1D;\n   --  Equivalent to: \"P_2D.X := P_1D.X;\"\n\n   P_2D.Y := 0.7;\n\n   Display (P_2D);\nend Show_Points;\n",
