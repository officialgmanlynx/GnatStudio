    "text": "with Points; use Points;\n\nprocedure Show_Points is\n   P_1D : Point_1D;\n   P_2D : Point_2D;\n   P_3D : Point_3D;\nbegin\n   P_1D := (X => 0.5);\n   Display (P_1D);\n\n   P_2D := (P_1D with Y => 0.7);\n   Display (P_2D);\n\n   P_3D := (P_2D with Z => 0.3);\n   Display (P_3D);\n\n   P_3D := (P_1D with Y | Z => 0.1);\n   Display (P_3D);\nend Show_Points;\n",
