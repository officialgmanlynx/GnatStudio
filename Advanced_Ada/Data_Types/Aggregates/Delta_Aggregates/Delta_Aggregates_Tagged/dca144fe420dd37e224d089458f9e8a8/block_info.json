    "text": "with Points; use Points;\n\nprocedure Show_Points is\n\n   P_3D : Point_3D;\n\n   function Reset (P_2D : Point_2D'Class)\n                   return Point_2D'Class is\n     ((P_2D with delta X | Y => 0.0));\n\nbegin\n   P_3D := (X => 0.1, Y => 0.2, Z => 0.3);\n   Display (P_3D);\n\n   P_3D := Point_3D (Reset (P_3D));\n   Display (P_3D);\n\nend Show_Points;\n",
