    "text": "with Points; use Points;\n\nprocedure Show_Points is\n\n   P_3D : Point_3D;\n\n   procedure Reset\n     (P_2D : in out Point_2D'Class) is\n   begin\n      Point_2D (P_2D) := (others => 0.0);\n   end Reset;\n\nbegin\n   P_3D := (X => 0.1, Y => 0.2, Z => 0.3);\n   Display (P_3D);\n\n   Reset (P_3D);\n   Display (P_3D);\n\nend Show_Points;\n\n\n",
