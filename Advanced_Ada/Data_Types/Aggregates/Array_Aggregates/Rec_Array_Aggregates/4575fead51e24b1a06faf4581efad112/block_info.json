    "text": "with Points; use Points;\n\nprocedure Show_Record_Aggregates is\n   PA : Point_3D_Array (1 .. 2);\nbegin\n   PA := [ (X => 3,\n            Y => 4,\n            Z => 5),\n           (X => 6,\n            Y => 7,\n            Z => 8) ];\n   Display (PA);\n\n   --  Array components are\n   --  uninitialized.\n   PA := [1 => <>,\n          2 => <>];\n   Display (PA);\nend Show_Record_Aggregates;\n",
