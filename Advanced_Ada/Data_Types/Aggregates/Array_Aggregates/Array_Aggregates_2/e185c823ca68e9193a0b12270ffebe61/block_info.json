    "text": "with Integer_Arrays; use Integer_Arrays;\n\nprocedure Show_Array_Aggregates is\n   N1 : Integer_Array := [others => 0];\n   --  ERROR: range is unknown\n\n   N2 : Integer_Array (1 .. 3) := [others => 0];\n   --  OK: range is known\nbegin\n   Display (N1);\n   Display (N2);\nend Show_Array_Aggregates;\n",
