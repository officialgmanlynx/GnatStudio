    "text": "with Points; use Points;\n\nprocedure Show_Array_Aggregates is\n   P : Point_3D;\nbegin\n   --  Positional component association\n   P := (0, 1, 2);\n\n   Display (P);\n\n   --  Named component association\n   P := (1 => 3,\n         2 => 4,\n         3 => 5);\n\n   Display (P);\nend Show_Array_Aggregates;\n",
