    "text": "with Points; use Points;\n\nprocedure Show_Array_Aggregates is\n   P : Point_3D := [for I in Point_3D'Range => I];\nbegin\n   --  Each component is doubled\n   P := [for E of P => E * 2];\n\n   Display (P);\n\n   --  Each component is increased\n   --  by one\n   P := [for E of P => E + 1];\n\n   Display (P);\nend Show_Array_Aggregates;\n",
