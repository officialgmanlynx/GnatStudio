    "text": "package Custom_Recs is\n\n   --  Declaring a discriminant with an anonymous\n   --  access type and a default value:\n   type Rec (IA : access Integer :=\n                    new Integer'(0)) is\n   record\n      I : Integer := IA.all;\n   end record;\n\nend Custom_Recs;\n",
