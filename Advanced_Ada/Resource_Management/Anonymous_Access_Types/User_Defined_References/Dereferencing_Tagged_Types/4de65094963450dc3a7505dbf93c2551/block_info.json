    "text": "package Info is\n   type Id_Number (Id : Positive) is\n     tagged private;\n\n   procedure Show (R : Id_Number);\nprivate\n   type Id_Number (Id : Positive) is\n     tagged null record;\nend Info;\n\nwith Ada.Text_IO; use Ada.Text_IO;\n\npackage body Info is\n\n   procedure Show (R : Id_Number) is\n   begin\n      Put_Line (\"ID: \" & Positive'Image (R.Id));\n   end Show;\n\nend Info;\n",
