    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show (Name : String;\n                V    : access Integer) is\nbegin\n   Put_Line (Name & \".all: \"\n             & Integer'Image (V.all));\nend Show;\n\nwith Show;\n\nprocedure Show_Anonymous_Access_Types is\n   I_Var : aliased Integer;\n   A     : access Integer;\n   B     : access Integer;\nbegin\n   A := I_Var'Access;\n   B := A;\n\n   A.all := 22;\n\n   Show (\"A\", A);\n   Show (\"B\", B);\nend Show_Anonymous_Access_Types;\n",
