    "text": "!operations_c.h\nint * alloc_integer();\n\nvoid dealloc_integer(int *p_i);\n\nvoid add_one(int *p_i);\n\n!operations_c.c\n#include <stdlib.h>\n\nint * alloc_integer()\n{\n    return malloc(sizeof(int));\n}\n\nvoid dealloc_integer(int *p_i)\n{\n    free (p_i);\n}\n\nvoid add_one(int *p_i)\n{\n    *p_i = *p_i + 1;\n}\n",
