    "text": "with P;     use P;\nwith P.Aux; use P.Aux;\n\nprocedure Show_Heap_Constructor is\n\n   type T_Ref is access all T;\n\n   Global : T_Ref;\n\n   procedure Heap_Alloc is\n      Local : T_Ref;\n      To_Global : Boolean := True;\n   begin\n      Local := new T'(Make_Rumplestiltskin);\n      if To_Global then\n         Global := Local;\n      end if;\n   end Heap_Alloc;\n\nbegin\n   null;\nend Show_Heap_Constructor;\n",
