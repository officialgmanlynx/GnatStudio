    "text": "package Simple_Recs is\n\n   type Limited_Integer_Array (L : Positive) is\n     limited private;\n\n   subtype Limited_Integer_Array_2 is\n     Limited_Integer_Array (2);\n\nprivate\n\n   type Integer_Array is\n     array (Positive range <>) of Integer;\n\n   type Limited_Integer_Array (L : Positive) is\n     limited record\n      Arr : Integer_Array (1 .. L);\n   end record;\n\nend Simple_Recs;\n",
