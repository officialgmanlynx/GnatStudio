    "text": "package Show_Process_Array is\n\n   type My_Index is range 1 .. 10;\n   type My_Array is array (My_Index) of Integer;\n\n   procedure Process_Array\n     (X     : in out My_Array;\n      Index :        My_Index);\n\nend Show_Process_Array;\n\npackage body Show_Process_Array is\n\n   procedure Process_Array\n     (X     : in out My_Array;\n      Index :        My_Index) is\n   begin\n      X (Index) := X (Index) + 1;\n   end Process_Array;\n\nend Show_Process_Array;\n",
