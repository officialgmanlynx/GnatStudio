    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Aliasing is\n   type Integer_Access is access Integer;\n\n   A1, A2 : Integer_Access;\nbegin\n   A1 := new Integer;\n   A2 := A1;\n\n   A1.all := 22;\n   Put_Line (\"A1: \" & Integer'Image (A1.all));\n   Put_Line (\"A2: \" & Integer'Image (A2.all));\n\n   A2.all := 24;\n   Put_Line (\"A1: \" & Integer'Image (A1.all));\n   Put_Line (\"A2: \" & Integer'Image (A2.all));\nend Show_Aliasing;\n",
