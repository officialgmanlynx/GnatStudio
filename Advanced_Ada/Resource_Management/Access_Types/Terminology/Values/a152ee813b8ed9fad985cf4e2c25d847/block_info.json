    "text": "procedure Show_Values is\n\n   --  Access-to-object type\n   type Integer_Access is access Integer;\n\n   I1, I2, I3 : Integer_Access;\n\nbegin\n   I1 := new Integer;\n   I3 := new Integer;\n\n   --  Copying the access value of I1 to I2\n   I2 := I1;\n\n   --  Copying the designated value of I1\n   I3.all := I1.all;\n\nend Show_Values;\n",
