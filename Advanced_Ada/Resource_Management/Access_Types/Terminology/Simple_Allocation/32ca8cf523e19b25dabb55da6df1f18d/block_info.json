    "text": "procedure Show_Simple_Allocation is\n\n   --  Access-to-object type\n   type Integer_Access is access Integer;\n\n   --  Access object\n   I1 : Integer_Access;\n\nbegin\n   I1 := new Integer;\n   --    ^^^^^^^^^^^ allocating an object,\n   --                which becomes the designated\n   --                object for I1\n\nend Show_Simple_Allocation;\n",
