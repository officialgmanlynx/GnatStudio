    "text": "package Decimal_Vs_Float_Type_Decl is\n\n    --\n    --  Decimal type declaration\n    --\n    type Decimal_D3 is\n      delta 0.1 digits 3;\n\n    --\n    --  Floating-point type declaration\n    --\n    type Float_D3 is\n      digits 3;\n\nend Decimal_Vs_Float_Type_Decl;\n",
