    "text": "package P is\n\n   type T is null record;\n\n   procedure Process (A : T) is null;\n\nend P;\n\nprivate with P;\n\npackage Data is\n\n   type T2 is private;\n\n   procedure Process (A : T2);\n\nprivate\n\n   --  Information from P is\n   --  visible here\n   type T2 is new P.T;\n\nend Data;\n\npackage body Data is\n\n   procedure Process (A : T2) is\n   begin\n      P.Process (P.T (A));\n   end Process;\n\nend Data;\n\nwith Data; use Data;\n\nprocedure Main is\n   A : T2;\nbegin\n   null;\nend Main;\n",
