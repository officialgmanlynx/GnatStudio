    "text": "package Points is\n\n   type Point is private;\n\n   function Init return Point;\n\n   function \"+\" (P : Point;\n                 I : Integer) return Point;\n\nprivate\n\n   type Point is record\n      X, Y : Integer;\n   end record;\n\n   function Init return Point is (0, 0);\n\n   function \"+\" (P : Point;\n                 I : Integer) return Point is\n     (P.X + I, P.Y + I);\n\nend Points;\n",
