    "text": "procedure Show_Discriminant_Check is\n\n   type Rec (Valid : Boolean) is record\n      case Valid is\n         when True =>\n            Counter : Integer;\n         when False =>\n            null;\n      end case;\n   end record;\n\n   R : Rec (Valid => False);\n   I : Integer;\nbegin\n   I := R.Counter;\nend Show_Discriminant_Check;\n",
