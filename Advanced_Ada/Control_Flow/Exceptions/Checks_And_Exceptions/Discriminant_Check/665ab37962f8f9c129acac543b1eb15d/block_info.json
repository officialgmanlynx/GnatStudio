    "text": "procedure Show_Discriminant_Check is\n\n   type Rec (Valid : Boolean) is record\n      case Valid is\n         when True =>\n            Counter : Integer;\n         when False =>\n            null;\n      end case;\n   end record;\n\n   R : Rec (Valid => False);\nbegin\n   R := (Valid  => True,\n         Counter => 10);\nend Show_Discriminant_Check;\n",
