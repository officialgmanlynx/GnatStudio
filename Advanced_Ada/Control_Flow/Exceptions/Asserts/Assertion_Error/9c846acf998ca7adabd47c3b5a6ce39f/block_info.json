    "text": "with Ada.Assertions; use Ada.Assertions;\n\nprocedure Show_Assertion_Error is\n   I : constant Integer := 11;\n\nbegin\n   if I /= 10 then\n      raise Assertion_Error with \"I is not 10\";\n   end if;\n\nend Show_Assertion_Error;\n",
