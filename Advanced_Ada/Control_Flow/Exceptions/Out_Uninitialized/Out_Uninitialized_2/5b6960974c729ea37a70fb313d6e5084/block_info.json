    "text": "with Ada.Text_IO;  use Ada.Text_IO;\n\nprocedure Show_Out_Uninitialized_Warnings is\n\n    procedure Local (A : in out Integer) is\n    begin\n       A := 1;\n       raise Program_Error;\n    end Local;\n\n   B : Integer := 0;\n\nbegin\n   Local (B);\nexception\n   when others =>\n      Put_Line (\"Value for B is\"\n                & Integer'Image (B));\nend Show_Out_Uninitialized_Warnings;\n",
