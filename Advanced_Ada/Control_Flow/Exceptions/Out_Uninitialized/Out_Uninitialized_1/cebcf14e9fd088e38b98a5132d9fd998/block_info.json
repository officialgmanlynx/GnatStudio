    "text": "with Ada.Text_IO;  use Ada.Text_IO;\nprocedure Show_Out_Uninitialized is\n\n   procedure Local (A     : in out Integer;\n                    Error : Boolean) is\n   begin\n      A := 1;\n\n      if Error then\n         raise Program_Error;\n      end if;\n   end Local;\n\n   B : Integer := 0;\n\nbegin\n   Local (B, Error => True);\nexception\n   when Program_Error =>\n      Put_Line (\"Value for B is\"\n                & Integer'Image (B));  --  \"0\"\nend Show_Out_Uninitialized;\n",
