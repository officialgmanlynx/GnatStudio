    "text": "with Ada.Text_IO;  use Ada.Text_IO;\n\nprocedure Show_Out_Initialized_Rec is\n\n   type Rec is tagged record\n      Field : Integer;\n   end record;\n\n   procedure Local (A : in out Rec) is\n   begin\n      A.Field := 1;\n      raise Program_Error;\n   end Local;\n\n   V : Rec;\n\nbegin\n   V.Field := 0;\n   Local (V);\nexception\n   when others =>\n      Put_Line (\"Value of Field is\"\n                & V.Field'Img); -- \"1\"\nend Show_Out_Initialized_Rec;\n",
