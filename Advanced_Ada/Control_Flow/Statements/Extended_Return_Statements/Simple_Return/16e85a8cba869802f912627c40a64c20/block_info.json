    "text": "procedure Show_Return is\n\n   type Array_Of_Natural is\n     array (Positive range <>) of Natural;\n\n   function Sum (A : Array_Of_Natural)\n                 return Natural\n   is\n      Result : Natural := 0;\n   begin\n      for Index in A'Range loop\n         Result := Result + A (Index);\n      end loop;\n      return Result;\n   end Sum;\n\nbegin\n   null;\nend Show_Return;\n",
