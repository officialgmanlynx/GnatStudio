    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Statement_Identifier is\n   Arr   : constant array (1 .. 5) of Integer :=\n             (1, 4, 6, 42, 49);\n   Found : Boolean := False;\nbegin\n   Find_42 : for E of Arr loop\n      if E = 42 then\n         Found := True;\n         exit Find_42;\n      end if;\n   end loop Find_42;\n\n   Put_Line (\"Found: \" & Found'Image);\nend Show_Statement_Identifier;\n",
