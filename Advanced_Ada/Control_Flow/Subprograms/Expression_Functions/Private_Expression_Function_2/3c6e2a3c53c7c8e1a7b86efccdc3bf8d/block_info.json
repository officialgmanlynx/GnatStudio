    "text": "package My_Data is\n\n   type Data is private;\n\n   function Is_Valid (D : Data)\n                      return Boolean;\n\nprivate\n\n   type Data is record\n      Valid : Boolean;\n   end record;\n\nend My_Data;\n\npackage body My_Data is\n\n   function Is_Valid (D : Data)\n                      return Boolean is\n     (D.Valid);\n\nend My_Data;\n",
