    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Reduction_Expression is\n   A : array (1 .. 3) of Integer;\n   I : Integer;\nbegin\n   A := [2, 3, 4];\n   I := A'Reduce (\"*\", 1);\n\n   Put_Line (\"A = \"\n             & A'Image);\n   Put_Line (\"I = \"\n             & I'Image);\nend Show_Reduction_Expression;\n",
