    "text": "with Ada.Text_IO; use Ada.Text_IO;\n\nprocedure Show_Reduction_Expression is\n   I : Integer;\nbegin\n   I := [for I in 1 .. 3 =>\n           I + 1]'Reduce (\"+\", 0);\n   Put_Line (\"I = \"\n             & I'Image);\n\n   I := [for I in 1 .. 3 =>\n           I + 1]'Reduce (\"*\", 1);\n   Put_Line (\"I = \"\n             & I'Image);\nend Show_Reduction_Expression;\n",
