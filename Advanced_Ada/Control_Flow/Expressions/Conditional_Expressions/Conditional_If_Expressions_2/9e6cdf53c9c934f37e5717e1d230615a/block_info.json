    "text": "package Expr_Func is\n\n   type State is (Off, On, Waiting, Invalid);\n\n   function Toggled (S : State) return State;\n\nend Expr_Func;\n\npackage body Expr_Func is\n\n   function Toggled (S : State) return State is\n   begin\n      if S = Off then\n         return On;\n      elsif S = On then\n         return Off;\n      else\n         return S;\n      end if;\n   end Toggled;\n\nend Expr_Func;\n",
