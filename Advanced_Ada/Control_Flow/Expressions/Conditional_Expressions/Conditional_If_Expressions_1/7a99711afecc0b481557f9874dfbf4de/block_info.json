    "text": "package Expr_Func is\n\n   type State is (Off, On, Waiting, Invalid);\n\n   function Toggled (S : State) return State is\n     (if S = Off\n       then On\n       elsif S = On\n         then Off\n         else S);\n\nend Expr_Func;\n",
