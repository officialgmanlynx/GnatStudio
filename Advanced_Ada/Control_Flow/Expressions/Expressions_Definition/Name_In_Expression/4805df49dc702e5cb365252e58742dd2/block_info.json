    "text": "procedure Increment_By_One (I : in out Integer);\n\nprocedure Increment_By_One (I : in out Integer) is\nbegin\n   I := I + 1;\nend Increment_By_One;\n\nwith Increment_By_One;\n\nprocedure Show_Name_In_Expression is\n   V : Integer := 0;\nbegin\n   Increment_By_One ((V));\nend Show_Name_In_Expression;\n",
